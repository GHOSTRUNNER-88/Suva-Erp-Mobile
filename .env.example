# Same Firebase project as starterkit (see ../vyzor-nextjs-ts-approuter/starterkit/.env.local's
# NEXT_PUBLIC_FIREBASE_* — copy the same values here, just re-prefixed for Expo).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs, not secrets — copy verbatim from the
# checked-in google-services.json (oauth_client[].client_id, client_type 3
# = web) and GoogleService-Info.plist (CLIENT_ID, the iOS-type client).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Production API URL: https://erp.suvacorp.com.np
# For local development with physical phone or Expo Go: http://YOUR_PC_LAN_IP:3000
EXPO_PUBLIC_API_BASE_URL=https://erp.suvacorp.com.np